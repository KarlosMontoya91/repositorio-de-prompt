rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Anyone can read (visitors)
      allow read: if true;
      
      // Only the admin can write (create, update, delete)
      allow write: if request.auth != null && request.auth.token.email == 'karlosmontoya091@gmail.com';
    }
  }
}
